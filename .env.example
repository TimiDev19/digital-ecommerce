# Copy this file to .env.local, then replace each placeholder with a real value.
# Never commit .env.local or share the Supabase service role / Paystack secret keys.

# Supabase — required for accounts, catalog data, admin catalog changes, and orders.
# Find all three in Supabase Dashboard → your project → Project Settings → API.
# Project URL: Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public client key: use the anon/public key (safe for browser use with RLS enabled).
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Secret server key: service_role key. Server only; never add NEXT_PUBLIC_ to it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Admin login session signing key — required for /admin/login.
# Generate a unique value with: openssl rand -base64 32
# Keep it private and use the same value on every app server/hosting instance.
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Paystack — required only to accept live checkout payments and verify webhooks.
# Find your Secret Key in Paystack Dashboard → Settings → API Keys & Webhooks.
# Start with a test key (sk_test_...) while developing; use live key only for production.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_SECRET_KEY

# The canonical public address of the site. Used for sitemap, robots and payment return URLs.
# Local development: http://localhost:3000
# Production: your HTTPS domain, without a trailing slash.
# Also set the site origin in Supabase Auth → URL Configuration → Site URL. Add the /account and /account/update-password URLs to its redirect allow list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional order emails — EmailJS (https://www.emailjs.com/).
# Connect an email service (Gmail works for low volume), then create one email template.
# Template fields: To Email={{to_email}}, Subject={{subject}}, Content HTML={{{html_content}}}.
# Get the service/template IDs from their dashboard and the keys from Account → API Keys.
# These values are server-only; never expose the private key with a NEXT_PUBLIC_ prefix.
EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
EMAILJS_PRIVATE_KEY=YOUR_EMAILJS_PRIVATE_KEY
# Merchant order summaries are sent here (defaults to the StephGifts order inbox below).
ORDER_NOTIFICATION_EMAIL=oduneyestephen04@gmail.com
